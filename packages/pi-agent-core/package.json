{
  "name": "@meeh/pi-agent-core",
  "version": "0.1.0",
  "type": "module",
  "description": "Unified subagent and workflow control plane for pi. Merges in-process, subprocess, Claude, and Codex runtimes with universal discovery, JS worker workflows, and high-speed observability.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./control": "./src/control/index.ts",
    "./discovery": "./src/discovery/index.ts",
    "./runtimes": "./src/runtimes/index.ts",
    "./workflow": "./src/workflow/index.ts",
    "./observability": "./src/observability/index.ts",
    "./ui": "./src/ui/index.ts",
    "./superpowers-bridge": "./src/superpowers-bridge.ts"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagent",
    "workflow",
    "control-plane",
    "superpowers"
  ],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  },
  "license": "MIT"
}
