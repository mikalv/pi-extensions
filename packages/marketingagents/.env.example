# Optional runtime defaults for MarketingAgents.
# Provider credentials are read by pi-coding-agent in the usual ways.

MARKETINGAGENTS_MODEL=
MARKETINGAGENTS_THINKING=medium
MARKETINGAGENTS_SERVICE_TIER=

# Optional parent directory override. State is stored in <value>/.marketingagents.
MARKETINGAGENTS_HOME=

# CLI binaries used by the Higgsfield + Meta extensions (default to PATH lookup).
HIGGSFIELD_BIN=
META_BIN=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=
KIMI_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=
HF_TOKEN=
OPENCODE_API_KEY=
AI_GATEWAY_API_KEY=
AZURE_OPENAI_API_KEY=
