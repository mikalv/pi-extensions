{
  "name": "pi-copy-code",
  "version": "0.1.0",
  "description": "Copy fenced code blocks from the latest Pi assistant message",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "pi-extension", "clipboard", "code-block"],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
